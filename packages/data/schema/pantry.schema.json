{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cook.yunyoujun.cn/schema/pantry.schema.json",
  "title": "常备调料（pantry.json）",
  "type": "object",
  "required": ["options", "defaults"],
  "additionalProperties": false,
  "properties": {
    "options": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "defaults": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
