{
  "name": "cook",
  "type": "module",
  "version": "2.0.1",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^24.18.0 || ^26.13.1",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "build": "node scripts/build-web-output.mjs build",
    "build:full": "node scripts/build-web-output.mjs full",
    "build:site": "pnpm run build && pnpm run docs:build && node scripts/compose-product-site.mjs",
    "build:nuxt": "pnpm -C apps/web run build",
    "convert": "pnpm -C packages/cook run convert",
    "validate": "tsx scripts/validate-recipes.ts",
    "amounts:check": "tsx scripts/check-recipe-amounts.ts",
    "dietary:validate": "tsx scripts/validate-dietary.ts",
    "amounts:annotate": "tsx scripts/annotate-recipe-amounts.ts",
    "audit:amounts": "tsx scripts/audit-recipe-amounts.ts",
    "audit:loop": "tsx scripts/loop-report.ts",
    "check:videos": "tsx scripts/check-video-links.ts",
    "feedback:pull": "tsx scripts/pull-feedback.ts",
    "eval:search": "tsx scripts/eval-search.ts",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "howtocook": "tsx scripts/import-howtocook.ts",
    "images:upload": "tsx --env-file-if-exists=.env scripts/upload-recipe-images.ts",
    "fetch": "pnpm -C packages/cook run fetch",
    "dev": "pnpm -C apps/web run dev",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm -C docs run docs:build",
    "generate": "node scripts/build-web-output.mjs generate",
    "start:generate": "npx serve dist",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "preview": "pnpm -C apps/web run preview",
    "release": "bumpp",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -C packages/cook run build && pnpm -C apps/web run typecheck",
    "pack:skill": "tsx scripts/pack-skill.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.6",
    "@unocss/eslint-config": "^66.13.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.6.0",
    "@vueuse/core": "^15.0.0",
    "@yunlefun/sso": "0.7.0",
    "ajv": "^8.20.0",
    "baseline-browser-mapping": "^2.11.38",
    "bumpp": "^12.3.0",
    "consola": "^3.4.2",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "pinia": "^4.1.0",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
