{
  "name": "cook",
  "type": "module",
  "version": "2.0.0-beta.18",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "pnpm run convert && pnpm -C apps/web run generate && tsx scripts/copy-web-output.ts",
    "build:full": "pnpm run fetch && pnpm -C apps/web run generate && tsx scripts/copy-web-output.ts",
    "build:site": "pnpm run build && pnpm run docs:build && node scripts/compose-product-site.mjs",
    "build:nuxt": "pnpm -C apps/web run build",
    "build:android": "bash ./scripts/android/build.sh",
    "convert": "pnpm -C packages/cook run convert",
    "validate": "tsx scripts/validate-recipes.ts",
    "amounts:check": "tsx scripts/check-recipe-amounts.ts",
    "amounts:annotate": "tsx scripts/annotate-recipe-amounts.ts",
    "audit:amounts": "tsx scripts/audit-recipe-amounts.ts",
    "check:videos": "tsx scripts/check-video-links.ts",
    "feedback:pull": "tsx scripts/pull-feedback.ts",
    "eval:search": "tsx scripts/eval-search.ts",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "howtocook": "tsx scripts/import-howtocook.ts",
    "images:upload": "tsx --env-file-if-exists=.env scripts/upload-recipe-images.ts",
    "fetch": "pnpm -C packages/cook run fetch",
    "dev": "pnpm -C apps/web run dev",
    "dev:pwa": "pnpm -C apps/web run dev:pwa",
    "dev:android": "bash ./scripts/android/dev.sh",
    "bash:ios": "bash ./scripts/ios.sh",
    "dev:ios": "cap run ios -l",
    "ios": "cap run ios",
    "android": "cap run android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm -C docs run docs:build",
    "generate": "pnpm -C apps/web run generate && tsx scripts/copy-web-output.ts",
    "start:generate": "npx serve dist",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "preview": "pnpm -C apps/web run preview",
    "release": "bumpp",
    "sync": "cap sync",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -C packages/cook run build && pnpm -C apps/web run typecheck",
    "pack:skill": "tsx scripts/pack-skill.ts"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/dialog": "8.0.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@types/node": "^25.9.5",
    "@unocss/eslint-config": "^66.7.5",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "@yunlefun/sso": "0.7.0",
    "ajv": "^8.20.0",
    "baseline-browser-mapping": "^2.11.13",
    "bumpp": "^11.1.0",
    "consola": "^3.4.2",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "pinia": "^3.0.4",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "unplugin": "^3.0.0",
    "vite": "^8.0.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
