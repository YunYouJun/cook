    "799": {
      "name": "排骨山药玉米汤",
      "sourceLink": "https://github.com/Anduin2017/HowToCook/blob/master/dishes/soup/排骨山药玉米汤/排骨山药玉米汤.md",
      "sourceFingerprint": "10bf3a1c67762219",
      "referenceServings": 2,
      "mealRole": "汤菜",
      "servingEvidence": [
        {
          "block": 6,
          "text": "每次制作前需要确定计划做几份。一份正好够 2 人喝。"
        }
      ],
      "mainIngredientEvidence": [
        {
          "block": 8,
          "item": 0,
          "text": "排骨 500g"
        },
        {
          "block": 8,
          "item": 1,
          "text": "山药 1 根（大约 300g）"
        },
        {
          "block": 8,
          "item": 2,
          "text": "胡萝卜 1 根（大约 150g）"
        },
        {
          "block": 8,
          "item": 3,
          "text": "玉米 1 根（大约 250g）"
        }
      ],
      "addedOil": {
        "lower": 10,
        "upper": 10,
        "unit": "ml",
        "evidence": [
          {
            "block": 8,
            "item": 7,
            "text": "食用油 10ml"
          },
          {
            "block": 10,
            "item": 2,
            "text": "**翻炒排骨**：\n• 热锅，倒入 10ml 食用油，等待 10 秒让油温升高。\n• 放入剩余大约 10g 姜片爆香。\n• 放入全部准备好的排骨，保持中火翻炒大约 1 分钟，至排骨表面微焦。"
          }
        ],
        "note": "翻炒排骨用 10ml 油；汤内肉和骨头本身的脂肪不计为添加油。"
      },
      "packingNote": "用防漏容器分装，汤和固形物一起彻底复热；搭配其他菜。"
    },
    "800": {
      "name": "排骨苦瓜汤",
      "sourceLink": "https://github.com/Anduin2017/HowToCook/blob/master/dishes/soup/排骨苦瓜汤/排骨苦瓜汤.md",
      "sourceFingerprint": "35d355e07cd5614c",
      "referenceServings": 4,
      "mealRole": "汤菜",
      "servingEvidence": [
        {
          "block": 9,
          "text": "每次制作前需要确定计划做几份。一份正好够 4 个人吃。每份："
        }
      ],
      "mainIngredientEvidence": [
        {
          "block": 10,
          "item": 0,
          "text": "排骨 250g 到 500g"
        },
        {
          "block": 10,
          "item": 1,
          "text": "苦瓜 100g 到 200g"
        },
        {
          "block": 10,
          "item": 2,
          "text": "虾皮 5g 到 15g"
        }
      ],
      "addedOil": {
        "lower": 0,
        "upper": 0,
        "unit": "g",
        "evidence": [
          {
            "block": 10,
            "item": 0,
            "text": "排骨 250g 到 500g"
          },
          {
            "block": 10,
            "item": 1,
            "text": "苦瓜 100g 到 200g"
          },
          {
            "block": 10,
            "item": 2,
            "text": "虾皮 5g 到 15g"
          },
          {
            "block": 10,
            "item": 3,
            "text": "生姜 5~10g（可选，用于焯水时去腥）"
          },
          {
            "block": 12,
            "item": 0,
            "text": "排骨洗净，切到约 4cm ±2cm * 3 ± 2cm 的小块（如没有剁排骨的工具，可以求助摊主）"
          },
          {
            "block": 12,
            "item": 1,
            "text": "炒锅倒入冷水 700ml 和排骨一起加热至煮沸，关火捞出排骨"
          },
          {
            "block": 12,
            "item": 2,
            "text": "苦瓜中间切为两半，清除干净内部的种子和苦瓜瓤，切为 0.5 ± 0.3 cm 的苦瓜条，洗净\n使用汤锅进行烹饪\n• 汤锅倒入水 1100ml 和排骨，大火\n• 等待水沸腾后将苦瓜和虾皮下锅转小火，放等待 120~240 分钟（在 120 分钟之后可以捞出一块肉进行品尝，若肉可以较为轻松的从骨头上分离即可关火）\n• 出锅时加盐和白胡椒，推荐量为每 250ml 0.3 到 0.6g 盐，0.1 到 0.5g 白胡椒\n使用电压力锅进行烹饪\n• 倒入 1000ml 水和排骨，虾皮和苦瓜\n• 选择炖汤功能，进行烹饪（一般为加压烹饪 45 分钟）\n• 出锅，和汤锅一样进行加盐和胡椒"
          },
          {
            "block": 14,
            "item": 0,
            "text": "可以使用其他带有鲜味的食材代替虾皮，如瑶柱"
          }
        ],
        "note": "已核对全部原料、汤锅和电压力锅两条步骤及可选项，均未额外添加油；不表示零脂肪。"
      },
      "packingNote": "按原文四人配方分装，不把汤单独当作完整午餐；使用防漏容器。"
    },
