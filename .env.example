# Apple Development Team ID
# 用于 iOS 应用签名和打包
APPLE_DEVELOPMENT_TEAM=

# 飞书开放平台应用凭证
# 用于 cook fetch 命令从飞书拉取菜谱数据
# 获取方式: https://open.feishu.cn/app
# 1. 创建或选择应用
# 2. 在"凭证与基础信息"中获取 App ID 和 App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=


# 用户反馈导出（pnpm feedback:pull）
# cook-feedback 云函数的 HTTP 访问地址，以及与云函数环境变量 COOK_FEEDBACK_EXPORT_TOKEN 相同的口令
COOK_FEEDBACK_URL=
COOK_FEEDBACK_TOKEN=
