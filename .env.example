# Apple Development Team ID
# 用于 iOS 应用签名和打包
APPLE_DEVELOPMENT_TEAM=

# 飞书开放平台应用凭证
# 用于 cook fetch 命令从飞书拉取菜谱数据
# 获取方式: https://open.feishu.cn/app
# 1. 创建或选择应用
# 2. 在"凭证与基础信息"中获取 App ID 和 App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Microsoft Clarity：复用 Cook 项目；显式留空可关闭统计
# 静态部署须在构建前设置；分叉项目请使用自己的项目 ID 和域名
NUXT_PUBLIC_CLARITY_PROJECT_ID=ks1ebw03i5
NUXT_PUBLIC_CLARITY_DOMAINS=cook.yunyoujun.cn,cook.yunle.fun

